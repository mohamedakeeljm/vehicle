# Reminder scheduler timezone & cron (Sri Lanka Standard Time Asia/Colombo)
TIMEZONE=Asia/Colombo
REMINDER_CRON="0 7 * * *" # Daily at 7:00 AM Sri Lanka Time
MAX_RETRY_ATTEMPTS=3
UPLOAD_DIR=./uploads
