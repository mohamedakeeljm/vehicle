PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5173
JWT_SECRET=super_secret_jwt_key_vehicleguard_lk_2026_dev_secure
JWT_EXPIRES_IN=7d
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vehicleguard?schema=public

# Email SMTP configuration (Ethereal test account by default or user's SMTP)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
